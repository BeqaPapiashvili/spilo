generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id                String       @id @default(cuid())
  phone             String?      @unique
  email             String?      @unique
  password          String?
  name              String?
  firstName         String?
  lastName          String?
  idNumber          String?
  isGeorgianCitizen Boolean      @default(true)
  address           String?      @db.Text
  smsNotify         Boolean      @default(true)
  emailNotify       Boolean      @default(true)
  role              String       @default("CUSTOMER") // CUSTOMER | SUPER_ADMIN | STORE_MANAGER | MERCHANT
  storeId           String?
  store             Store?       @relation(fields: [storeId], references: [id], onDelete: SetNull)
  orders            Order[]
  cart              Cart?
  addresses         Address[]
  reviews           Review[]
  priceAlerts       PriceAlert[]
  auditLogs         AuditLog[]
  supportTickets    SupportTicket[]
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([storeId])
  @@index([role])
}

model Category {
  id           String     @id @default(cuid())
  name         String
  slug         String     @unique
  icon         String?
  childrenJson String?    @db.Text
  parentId     String?
  parent       Category?  @relation("CategoryToCategory", fields: [parentId], references: [id], onDelete: SetNull)
  children     Category[] @relation("CategoryToCategory")
  products     Product[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Brand {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  logo      String?
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Store {
  id           String    @id @default(cuid())
  name         String
  slug         String    @unique
  logo         String?   @db.Text
  coverImage   String?   @db.Text
  description  String?   @db.Text
  phone        String?
  address      String?   @db.Text
  facebookUrl  String?
  instagramUrl String?
  websiteUrl    String?
  city          String?
  email         String?
  workingHours  String?
  mapUrl         String?
  latitude       Float?
  longitude      Float?
  pickupEnabled  Boolean   @default(false)
  pickupNote     String?
  sortOrder      Int       @default(0)
  isActive       Boolean   @default(true)
  products       Product[]
  coupons        Coupon[]
  merchants      User[]
  warehouses     Warehouse[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([isActive])
  @@index([name])
  @@index([sortOrder])
}

model Product {
  id                 String           @id @default(cuid())
  title              String
  slug               String           @unique
  sku                String           @unique
  description        String?          @db.Text
  price              Float
  costPrice          Float?
  discountPrice      Float?
  discountPercentage Int?
  monthlyInstallment Float?
  stock              Int              @default(10)
  categoryId         String
  category           Category         @relation(fields: [categoryId], references: [id])
  brandId            String
  brand              Brand            @relation(fields: [brandId], references: [id])
  storeId            String?
  store              Store?           @relation(fields: [storeId], references: [id], onDelete: SetNull)
  images             Json             // Array of image URLs stored as JSON
  specs              Json?            // Structured specifications JSON
  colorName          String?
  storage            String?
  isFeatured         Boolean          @default(false)
  isFlashDeal        Boolean          @default(false)
  status             String           @default("PUBLISHED") // "PUBLISHED" | "PENDING_REVIEW"
  isApproved         Boolean          @default(true)
  cartItems          CartItem[]
  orderItems         OrderItem[]
  reviews            Review[]
  variants           ProductVariant[]
  priceAlerts        PriceAlert[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([categoryId])
  @@index([brandId])
  @@index([storeId])
  @@index([status])
  @@index([isFeatured])
  @@index([isFlashDeal])
}

model Review {
  id               String   @id @default(cuid())
  productId        String
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId           String?
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  author           String
  rating           Int      @default(5)
  comment          String   @db.Text
  verifiedPurchase Boolean  @default(true)
  likes            Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([productId])
  @@index([userId])
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String?  @default("ჩემი მისამართი")
  city       String   @default("თბილისი")
  street     String
  apartment  String?
  postalCode String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

model ProductVariant {
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name          String   // e.g. "Color", "Storage"
  type          String   @default("text") // "color" | "text"
  label         String
  value         String
  colorHex      String?
  priceModifier Float    @default(0)
  stock         Int      @default(10)
  sku           String?
  image         String?  @db.Text
  inStock       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([productId])
}

model PriceAlert {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email       String
  targetPrice Float
  isActive    Boolean  @default(true)
  notified    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([productId])
  @@index([userId])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String?    @unique
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String?    @unique
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  userId          String?
  user            User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName    String
  customerEmail   String?
  contactPhone    String
  shippingAddress String      @db.Text
  paymentMethod   String
  paymentStatus   String      @default("PENDING")
  status          OrderStatus @default(PENDING)
  deliveryDate    DateTime?
  deliveryMethod  String?     @default("delivery")
  personType      String?     @default("physical")
  idNumber        String?
  notes           String?     @db.Text
  couponCode      String?
  discountAmount  Float?      @default(0)
  totalAmount     Float
  items           OrderItem[]
  returns         OrderReturn[]
  payments        Payment[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model Payment {
  id                String   @id @default(cuid())
  orderId           String
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider          String   @default("UNITED_PAYMENT")
  status            String   @default("PENDING")
  amount            Float
  currency          String   @default("GEL")
  bankCode          Int      @default(1)
  installmentNumber Int      @default(1)
  otherTrxCode      String   @unique
  virtualPosOrderId String?
  codeForHash       String?
  threeDUrl         String?  @db.Text
  resultCode        String?
  resultMessage     String?  @db.Text
  refundRequestId   String?
  rawResponse       String?  @db.Text
  rawCallback       String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([orderId])
  @@index([status])
  @@index([virtualPosOrderId])
}

model OrderItem {
  id               String   @id @default(cuid())
  orderId          String
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId        String
  product          Product  @relation(fields: [productId], references: [id])
  title            String
  sku              String?
  quantity         Int
  price            Float    // Sold price per unit
  originalPrice    Float?   // Catalog original price on site
  discountPrice    Float?   // Catalog discount price on site
  costPrice        Float?   // Sourcing cost price
  selectedVariants Json?    // Chosen variants: color, storage, etc.
  image            String?  @db.Text
  storeId           String?
  storeName         String?
  warehouseId       String?
  warehouse         Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  fulfillmentStatus String   @default("PENDING")
  createdAt         DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([storeId])
  @@index([warehouseId])
}

model Warehouse {
  id         String      @id @default(cuid())
  storeId    String
  store      Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name       String
  address    String      @db.Text
  city       String
  phone      String?
  latitude   Float?
  longitude  Float?
  isDefault  Boolean     @default(false)
  orderItems OrderItem[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([storeId])
}

model AdminUser {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("SUPER_ADMIN") // SUPER_ADMIN | STORE_MANAGER
  status    String   @default("ACTIVE")        // ACTIVE | INACTIVE
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  adminEmail String
  adminName  String?
  action     String   // e.g. "PRODUCT_CREATE", "STOCK_UPDATE", "ORDER_STATUS_UPDATE", "COUPON_CREATE", "LOGIN"
  entity     String?  // e.g. "Product", "Order", "Category", "Coupon", "User"
  target     String?  // Target description or ID
  details    String?  @db.Text
  ipAddress  String?  @db.VarChar(64)
  userAgent  String?  @db.Text
  createdAt  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model Promotion {
  id                 String   @id @default(cuid())
  title              String
  name               String?
  slug               String?
  description        String?  @db.Text
  subtitle           String?
  image              String?  @db.Text
  bannerImage        String?  @db.Text
  link               String?
  discountType       String?  @default("percentage")
  discountValue      Float?
  discountPercentage Int?
  startDate          String?
  endDate            String?
  status             String?  @default("ACTIVE")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Coupon {
  id             String    @id @default(cuid())
  code           String    @unique
  discount       Float?
  discountType   String?   @default("percentage")
  discountValue  Float?
  minOrderAmount Float?    @default(0)
  startDate      String?
  endDate        String?
  usedCount      Int       @default(0)
  usageLimit     Int?
  status         String    @default("ACTIVE")
  validUntil     DateTime?
  isActive       Boolean   @default(true)
  storeId        String?
  store          Store?    @relation(fields: [storeId], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([storeId])
}

model Banner {
  id           String   @id @default(cuid())
  title        String
  subtitle     String?
  ctaText      String?  @default("ნახვა")
  ctaLink      String?
  image        String?  @db.Text
  imageDesktop String?  @db.Text
  position     String   @default("HERO")
  priority     Int      @default(1)
  isActive     Boolean  @default(true)
  link         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SupportTicket {
  id              String           @id @default(cuid())
  userId          String?
  customerId      String?          @default("") // Persistent guest/client session identifier
  userName        String           @default("სტუმარი")
  userPhone       String?          @default("+995 5XX XX XX XX")
  userEmail       String?          @default("")
  topic           String?          @default("ონლაინ კონსულტაცია")
  status          String           @default("OPEN") // OPEN | IN_PROGRESS | RESOLVED | CLOSED
  isUserTyping    Boolean          @default(false)
  isAdminTyping   Boolean          @default(false)
  typingAdminName String?          @default("")
  assignedToName  String?          @default("")
  messages        SupportMessage[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user            User?            @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([customerId])
  @@index([status])
  @@index([updatedAt])
}

model SupportMessage {
  id          String        @id @default(cuid())
  ticketId    String
  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderRole  String        // "user" | "admin" | "bot"
  senderName  String?
  senderEmail String?
  text        String        @db.Text
  attachment  Json?         // { type: "image"|"file", url: string, name: string }
  isRead      Boolean       @default(false)
  createdAt   DateTime      @default(now())

  @@index([ticketId])
  @@index([createdAt])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String?
  sessionId String?
  productId String
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([sessionId])
  @@index([productId])
}

model CompareItem {
  id        String   @id @default(cuid())
  userId    String?
  sessionId String?
  productId String
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([sessionId])
  @@index([productId])
}

model RecentlyViewed {
  id        String   @id @default(cuid())
  userId    String?
  sessionId String?
  productId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([sessionId])
  @@index([productId])
}

model CMSPage {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  content     String   @db.Text
  lastUpdated DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model NavigationItem {
  id        String   @id @default(cuid())
  label     String
  url       String
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InstallmentOption {
  id              String   @id @default(cuid())
  bankName        String
  bankCode        String   @unique
  name            String?  @default("")
  months          Int      @default(12)
  availableMonths Json?
  minAmount       Float?   @default(50)
  maxAmount       Float?   @default(15000)
  ratePercent     Float    @default(0)
  merchantCode    String?  @default("")
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model DeliveryZone {
  id            String   @id @default(cuid())
  title         String
  price         Float
  estimatedDays String
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SeoSetting {
  id              String   @id @default(cuid())
  pageSlug        String   @unique
  metaTitle       String
  metaDescription String?  @db.Text
  metaKeywords    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StorefrontSection {
  id        String   @id @default(cuid())
  key       String?
  type      String   @default("PRODUCT_CAROUSEL")
  title     String?
  subtitle  String?
  isEnabled Boolean  @default(true)
  sortOrder Int      @default(0)
  config    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model OtpVerification {
  id          String   @id @default(cuid())
  phone       String   @db.VarChar(30)
  hashedCode  String   @db.VarChar(255)
  expiresAt   DateTime
  attempts    Int      @default(0)
  used        Boolean  @default(false)
  ipAddress   String?  @db.VarChar(64)
  createdAt   DateTime @default(now())

  @@index([phone, createdAt])
  @@index([phone, used, expiresAt])
}

enum ReturnType {
  RETURN
  EXCHANGE
}

enum ReturnStatus {
  REQUESTED
  IN_PROGRESS
  COURIER_ASSIGNED
  COMPLETED
  REJECTED
}

model OrderReturn {
  id            String       @id @default(cuid())
  orderId       String
  order         Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type          ReturnType   @default(RETURN)
  status        ReturnStatus @default(REQUESTED)
  reason        String       @db.Text
  internalNotes String?      @db.Text
  items         Json?
  exchangeTo    String?      @db.Text
  logs          ReturnLog[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([orderId])
}

model ReturnLog {
  id            String        @id @default(cuid())
  orderReturnId String
  orderReturn   OrderReturn   @relation(fields: [orderReturnId], references: [id], onDelete: Cascade)
  status        ReturnStatus?
  action        String        // CREATED, STATUS_CHANGED, NOTE_ADDED
  comment       String?       @db.Text
  authorName    String?
  authorEmail   String?
  createdAt     DateTime      @default(now())

  @@index([orderReturnId])
}
