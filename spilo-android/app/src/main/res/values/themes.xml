<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.Spilo" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/brand_orange</item>
        <item name="colorSecondary">@color/brand_dark</item>
        <item name="android:statusBarColor">@color/brand_bg</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>
        <item name="android:navigationBarColor">@color/brand_bg</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>

    <!-- Splash screen theme. -->
    <style name="Theme.Spilo.Splash" parent="Theme.Spilo">
        <item name="android:windowBackground">@drawable/splash_background</item>
    </style>
</resources>
